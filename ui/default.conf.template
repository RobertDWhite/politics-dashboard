server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;

    # Re-resolve the API hostname every 10s so DNS changes (rolling restart,
    # kube-dns rotation) don't pin nginx to a stale IP at startup.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    location /api/ {
        # API_UPSTREAM is substituted at container start by the nginx-unprivileged
        # base image's envsubst hook. Default targets the docker-compose service
        # "api"; in Kubernetes set API_UPSTREAM to the Service DNS, e.g.
        # http://politics-api.politics.svc.cluster.local:8000
        #
        # Order matters: `set` lives in the rewrite module, and `rewrite ... break`
        # halts further rewrite-module processing — so `set` MUST come first.
        set $api_upstream ${API_UPSTREAM};

        # Strip the /api/ prefix before forwarding (the API serves /articles,
        # /accounts, /config, etc. — no /api/ namespace).
        rewrite ^/api/(.*)$ /$1 break;

        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
