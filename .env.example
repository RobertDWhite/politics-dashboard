# Secrets and runtime overrides for the politics dashboard.
# Copy to .env and fill in.

# LLM API key (Anthropic, OpenAI, etc.). Leave blank for local Ollama.
LLM_API_KEY=

# FreshRSS Greader API password — only used when feeds.source: freshrss
FRESHRSS_API_PASSWORD=

# Optional: override Twitter handle lists from YAML
# (only honored when twitter.handles_env_prefix is set in config.yaml)
# X_POLITICS=anncoulter,benshapiro
# X_GOVERNMENT=POTUS,WhiteHouse

# UI: Nitter URL exposed to the BROWSER for the iframe embed.
# Must be reachable from end users (the API can use a different internal URL).
VITE_NITTER_EMBED_BASE=
